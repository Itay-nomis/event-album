# Copy to .env before running:  copy .env.example .env   (Windows)  /  cp .env.example .env
POSTGRES_USER=album
POSTGRES_PASSWORD=change-me
POSTGRES_DB=album
DATABASE_URL=postgresql://album:change-me@postgres:5432/album

REDIS_URL=redis://redis:6379/0

# Local SeaweedFS runs without auth; keys are placeholders. Real keys come with the cloud stage.
S3_ENDPOINT=http://storage:8333
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_BUCKET=photos

# Storage backend: s3 (SeaweedFS / any S3) or azure (Azure Blob + DefaultAzureCredential)
STORAGE_BACKEND=s3
# For azure:
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=photos

# Optional: the public URL guests use (QR code target). If empty it is detected from the
# request (works with the Cloudflare quick tunnel). Example: https://xyz.trycloudflare.com
PUBLIC_BASE_URL=
