# Copy to .env before running:  copy .env.example .env   (Windows)  /  cp .env.example .env
POSTGRES_USER=album
POSTGRES_PASSWORD=change-me
POSTGRES_DB=album
DATABASE_URL=postgresql://album:change-me@postgres:5432/album

REDIS_URL=redis://redis:6379/0

# Local SeaweedFS runs without auth; keys are placeholders. Real keys come with the cloud stage.
S3_ENDPOINT=http://storage:8333
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_BUCKET=photos
