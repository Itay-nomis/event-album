# Keys of the Kubernetes Secret "event-album-secrets" (namespace event-album).
# scripts/local-up.ps1 creates the Secret for you with a random password. To choose your own:
#   copy secrets.env.example secrets.env   (secrets.env is gitignored - never commit it)
#   edit the values, then run local-up.ps1 again (or the kubectl command in docs/GUIDE.he.md).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://album:change-me@postgres:5432/album
# SeaweedFS runs without auth locally; boto3 still wants some value
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
